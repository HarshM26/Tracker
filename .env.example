# Postgres connection string (Vercel Postgres / Neon / Supabase all work)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random long string used to sign login sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: set these before running `npm run seed` to choose exact passwords
# instead of getting random generated ones printed to the console.
# SEED_HARSH_PASSWORD=
# SEED_SHRISTI_PASSWORD=
# SEED_RUCHIT_PASSWORD=
